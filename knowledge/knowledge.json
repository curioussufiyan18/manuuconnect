      {
        "id": "faq_what_is",
        "question": "What is MANUU Connect?",
        "answer": "MANUU Connect is a platform for CS/IT students at MANUU that promotes collaboration, innovation, and learning. It provides opportunities to participate in hackathons, workshops, and real-world projects while developing technical, professional, and soft skills."
      },
      {
        "id": "faq_why_created",
        "question": "Why was MANUU Connect created?",
        "answer": "It was created to provide talented CS/IT students with opportunities, mentorship, and exposure. It helps students showcase their potential, collaborate on projects, and prepare for academia and industry."
      },
      {
        "id": "faq_who_can_join",
        "question": "Who can join MANUU Connect?",
